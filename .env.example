# Copy this file to .env and fill in the values. .env is gitignored.

# Supabase -> Connect -> Session pooler URI, with your database password filled in.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres

# Any long random string, e.g. from: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
